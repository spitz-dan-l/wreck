{
    "compilerOptions": {
        "target": "es2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "allowImportingTsExtensions": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "strict": true,
        "noImplicitReturns": true,
        "types": ["node"]
    },
    "include": ["*.ts"]
}
