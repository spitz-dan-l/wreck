{
  "name": "wreck",
  "version": "1.0.0",
  "description": "Venience World: a parser-based interactive fiction game with a novel interface.",
  "main": "index.js",
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && mocha --require ./build/tests/setup.js build/tests",
    "debug": "echo 'Remember to open chrome://inspect in a tab before running this.\\n' && tsc -p tsconfig.json && mocha --require ./build/tests/setup.js --inspect-brk build/tests",
    "build": "webpack --mode production",
    "build-dev": "webpack --mode development",
    "clean": "rm -rf build dist/venience.js.map"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spitz-dan-l/wreck.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spitz-dan-l/wreck/issues"
  },
  "homepage": "https://github.com/spitz-dan-l/wreck#readme",
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.1",
    "jsdom": "^30.0.1",
    "mocha": "^12.0.0",
    "ts-loader": "^9.6.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.9.3",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "@types/lodash": "^4.17.25",
    "csstype": "^3.2.3",
    "csx": "^10.0.2",
    "immer": "^11.1.18",
    "iterative": "^1.9.2",
    "lodash": "^4.18.1",
    "ts-toolbelt": "^4.10.0",
    "typestyle": "^2.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
