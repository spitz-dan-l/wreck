{
  "name": "wreck",
  "version": "1.0.0",
  "description": "Venience World: a parser-based interactive fiction game with a novel interface.",
  "main": "index.js",
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && mocha --require ./build/tests/setup.js build/tests",
    "debug": "echo 'Remember to open chrome://inspect in a tab before running this.\\n' && tsc -p tsconfig.json && mocha --require ./build/tests/setup.js --inspect-brk build/tests",
    "build": "esbuild src/typescript/entry_points/build_prod.tsx --bundle --minify --target=es2020 --outfile=dist/venience.js --log-level=warning",
    "build-dev": "esbuild src/typescript/entry_points/build_dev.tsx --bundle --sourcemap --target=es2020 --outfile=dist/venience.js --log-level=warning",
    "clean": "rm -rf build dist/venience.js.map"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spitz-dan-l/wreck.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spitz-dan-l/wreck/issues"
  },
  "homepage": "https://github.com/spitz-dan-l/wreck#readme",
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "mocha": "^12.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@types/lodash": "^4.17.25",
    "csstype": "^3.2.3",
    "lodash": "^4.18.1",
    "typestyle": "^2.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
